# Ollama Configuration (Free & Local)
# Ollama runs locally - no API key needed!
# Just install Ollama and pull a model

# Optional: Override default model (default: llama3)
# Available models:  llama3, codellama, mistral, phi-3, gemma
OLLAMA_MODEL=llama3

# Optional: Override Ollama server URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
